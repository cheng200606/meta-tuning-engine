    { "id": "test-tool-01", "category": "tool", "instruction": "读取 stock.txt，回答 pear 的数量（只回答数字）。", "fixtures": ["stock.txt 两行：apple: 12；pear: 30"], "tools_expected": ["read_file"], "expected": "答案含 30" },
