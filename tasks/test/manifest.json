    { "id": "test-reas-10", "category": "reasoning", "instruction": "查询北京、上海、广州今天的气温，按从暖到冷排序，回答气温第二高的城市，直接给出城市名。", "fixtures": ["天气表：北京 5℃；上海 12℃；广州 24℃"], "tools_expected": ["get_weather"], "expected": "答案含 上海" },

